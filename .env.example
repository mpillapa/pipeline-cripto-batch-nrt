# Plantilla de variables de entorno. Copiar a `.env` antes de levantar:
#
#     Copy-Item .env.example .env
#
# `.env` NO se versiona (esta en .gitignore). Este archivo si, con valores
# ficticios, para que cualquiera sepa que variables hacen falta.
#
# TODAS LAS CREDENCIALES DE AQUI SON FICTICIAS Y SOLO VALIDAS EN LOCAL.
# El entorno no tiene TLS, ni gestion de secretos, ni respaldos. No replicar
# fuera de la maquina de desarrollo.

# ---------------------------------------------------------------------------
# AIRFLOW
# ---------------------------------------------------------------------------
# UID del usuario dentro del contenedor. 50000 es el valor de la imagen
# oficial. En Linux conviene poner el propio (`id -u`) para que los archivos
# que escriba Airflow en los volumenes montados no queden como root.
AIRFLOW_UID=50000

_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# ---------------------------------------------------------------------------
# MYSQL - base analitica del proyecto
# ---------------------------------------------------------------------------
# No confundir con el Postgres de metadatos de Airflow, que es otra cosa y no
# se publica al host.
MYSQL_DATABASE=cripto
MYSQL_USER=cripto
MYSQL_PASSWORD=cripto
MYSQL_ROOT_PASSWORD=root_cripto

# ---------------------------------------------------------------------------
# PARAMETROS DEL PIPELINE
# ---------------------------------------------------------------------------
# Tres simbolos. Cada uno de mas multiplica el volumen descargado, las
# particiones de Kafka y la memoria que necesita el entorno.
CRIPTO_SIMBOLOS=BTCUSDT,ETHUSDT,SOLUSDT

# Dias de historia que descarga el DAG 01. Con 365 y tres simbolos son unas
# 1095 velas diarias, que caben en una sola peticion por simbolo.
CRIPTO_DIAS_HISTORIA=365

# Endpoint publico. Se deja como variable para poder apuntar a un espejo o a un
# servidor de pruebas sin tocar codigo.
CRIPTO_API_BASE=https://api.binance.com

# ---------------------------------------------------------------------------
# MEMORIA
# ---------------------------------------------------------------------------
# Con 16 GB en la maquina y Docker Desktop configurado a 11-12 GB, estos
# valores dejan margen. Subirlos hace que algun contenedor muera por falta de
# memoria, casi siempre Elasticsearch, y el sintoma es un exit code 137.
ES_JAVA_OPTS=-Xms1g -Xmx1g
LS_JAVA_OPTS=-Xms512m -Xmx512m
