# ---------------------------------------------------------------------------
# Datos generados en tiempo de ejecucion
# ---------------------------------------------------------------------------
# Las zonas del data lake las crea el pipeline al ejecutarse. Versionarlas
# hincharia el repositorio con archivos binarios que cambian en cada corrida y
# que nadie va a leer en un diff.
datos/
datos_prueba/

# Estado interno de Spark: offsets y ventanas en curso. Es estado local de una
# ejecucion concreta, no codigo.
checkpoints/

# ---------------------------------------------------------------------------
# Airflow
# ---------------------------------------------------------------------------
logs/
plugins/
airflow.db
airflow-webserver.pid
standalone_admin_password.txt

# ---------------------------------------------------------------------------
# Variables de entorno y secretos
# ---------------------------------------------------------------------------
# .env lleva valores locales de la maquina de cada uno. Lo que se versiona es
# .env.example, con valores ficticios.
.env
*.pem
*.key

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Artefactos descargados
# ---------------------------------------------------------------------------
# El conector de Kafka para Spark lo instala el Dockerfile durante la
# construccion de la imagen. No se versiona: pesa varios MB y su version queda
# fijada en el Dockerfile, que si esta en el repositorio.
*.jar
*.zip
*.tar.gz

# ---------------------------------------------------------------------------
# Elasticsearch y Kibana
# ---------------------------------------------------------------------------
# Datos de los indices. Los tableros SI se versionan, exportados como NDJSON
# en kibana/, porque son configuracion y no datos.
elasticsearch/datos/

# ---------------------------------------------------------------------------
# Sistema operativo y editores
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~
